# ==============================================================================
# Aarogyam Environment Variables Template
# ==============================================================================

# --- Twilio Voice SOS Telephony Credentials ---
# Obtain these from your Twilio Console (https://console.twilio.com)
VITE_TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
VITE_TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Default fallback Twilio Phone Number (E.164 format e.g. +1234567890)
VITE_TWILIO_DEFAULT_FROM_NUMBER=+12025550199

# --- Multi-Hospital Dedicated Hotline Channels ---
# Channel 1:
VITE_TWILIO_FROM_1=+17372508034
VITE_TWILIO_TO_1=+919067375860

# Channel 2:
VITE_TWILIO_FROM_2=+17372324091
VITE_TWILIO_TO_2=+917387880399

# Channel 3 (Reserved for future hospital line addition):
VITE_TWILIO_FROM_3=
VITE_TWILIO_TO_3=

# --- Optional: Firebase Cloud Function Endpoint ---
# Set this once you deploy functions/index.js to your Firebase project:
# VITE_TWILIO_FUNCTION_URL=https://us-central1-aarogyam-30e7f.cloudfunctions.net/makeEmergencyCall
VITE_TWILIO_FUNCTION_URL=
